{
  // ==========================================================================
  // shop-order 索引结构声明 —— 【本期只落盘、不接线】（_meta.status = draft）
  // ==========================================================================
  //
  // 来源：order-consumer/sql/shop-order-date-format.json（全文原样，层级/数值/字段顺序未改），
  // 本文件只追加注释与 _meta。
  //
  // 为什么不接线：
  //   - 本期没有 OrderIndex 文档 struct，也没有对应的 sync Provider（区间扫描 / bulk 灌入 /
  //     对账期望值都还没实现），把它放进可执行清单会让 es:migrate 去建一个无法灌数的索引；
  //   - 因此 Registry 只把 _meta.status=active 的定义纳入 ExecutableDefinitions()，
  //     orders 仅参与 LoadDefinitions 的解析、校验与指纹计算（definition_test.go 覆盖）。
  //   - 二期接 orders 时：新增 internal/es/doc_order.go + internal/es/sync/order.go，
  //     并把这里的 status 改为 active，无需改 Registry 代码。
  //
  // 与 shop-product（indices/product.jsonc）的关键差异 —— 两套索引不能复用同一份配置假设：
  //   | 项              | shop-product        | shop-order            |
  //   |-----------------|---------------------|-----------------------|
  //   | number_of_shards| 15                  | 1                     |
  //   | number_of_replicas | 1              | 0（无副本）           |
  //   | index.sort      | price asc/sales desc/ficti desc | update_time desc |
  //   | analyzer 体系   | ik_max_word/ik_smart + pinyin + 单字 ngram | edge_ngram(1-18) + ngram + pinyin |
  //   | date format     | 无显式 format（默认 RFC3339） | 显式 yyyy-MM-dd HH:mm:ss |
  //   | _source excludes| 排除 4 个大文本     | 无 excludes           |
  //   | 字段数          | 18（含虚拟 desc）   | 13（无 copy_to）      |
  //
  // 依赖插件：analysis-pinyin（pinyin tokenizer）。本索引【不依赖 analysis-ik】；
  // edge_ngram / ngram 为 ES 内置。插件健康检查必须逐索引做，不能共用。

  "_meta": {
    "alias": "shop-order",
    "schema_version": 1,
    "status": "draft",
    "next_version_rule": "<alias>_v<N+1>",
    "copy_to_only_fields": [],
    "requires_plugins": ["analysis-pinyin"],
    "notes": "本期只落盘不接线。三个 date 字段显式声明 yyyy-MM-dd HH:mm:ss，而 order-consumer 实际用 time.Time 默认序列化写入 RFC3339，两者互不兼容：真按本 mapping 建索引，order-consumer 写入会 date_parse_exception。二期接线前必须先决定采用哪一份并同步 order-consumer 的序列化。"
  },

  "settings": {
    // 动态项，可原地修改（灌数期间临时置 -1，完成后必须恢复到 1s 以匹配本文件）。
    "refresh_interval": "1s",

    // 与 products 的 15 分片相差悬殊：本索引单分片，重建代价低，
    // 但 number_of_shards 依旧是【静态项】，要调整仍然只能蓝绿重建。
    "number_of_shards": 1,

    // 无副本：查询可用性依赖主分片，扩容/容灾诉求变化时这里要重新评估（动态项，可原地置 1）。
    "number_of_replicas": 0,

    "index": {
      "store.preload": [
        "nvd",
        "dvd"
      ],

      // 排序预置字段：只有 update_time desc（商品索引是 price/sales/ficti 三键）。
      // 同样【创建后不可改】，需要按 pay_time 或金额排序时必须建模期定完，否则重建。
      "sort.field": [
        "update_time"
      ],
      "sort.order": [
        "desc"
      ],

      // slowlog 三项与 products 完全相同，均为动态项。
      "search.slowlog.threshold.query.warn": "500ms",
      "search.slowlog.threshold.fetch.warn": "1s",
      "indexing.slowlog.threshold.index.warn": "1s"
    },

    // analyzer 体系与 products 完全不同：这里走 edge_ngram 前缀匹配（订单号输入即搜），
    // products 走 ik 中文分词（商品名语义检索）。两套 analyzer 配置互不可移植，
    // 任何变更都必须重建（已分词数据不会重刷）。
    "analysis": {
      "analyzer": {
        // 订单号前缀搜索的索引期 analyzer（未显式声明 filter，行为与 products 的 ik 系完全不同）。
        "edge_ngram_analyzer": {
          "tokenizer": "edge_ngram_tokenizer"
        },
        "ngram_analyzer": {
          "tokenizer": "ngram_tokenizer"
        },
        // 与 products 的 pinyin_analyzer 同名，但底层 tokenizer 多一个
        // ignore_pinyin_offset: false（见下），两者并非等价配置。
        "pinyin_analyzer": {
          "tokenizer": "pinyin_tokenizer"
        }
      },
      "tokenizer": {
        "pinyin_tokenizer": {
          "type": "pinyin",
          "keep_separate_first_letter": true,
          "keep_full_pinyin": true,
          "keep_original": true,
          "limit_first_letter_length": 16,
          "lowercase": true,
          "remove_duplicated_term": true,
          // 与 products 的唯一差异项：false 会保留 token offset，高亮位置更准但开销略高。
          // 这行是「同名 analyzer 不等于同行为」的直接证据，跨索引复制配置前必须逐参数比对。
          "ignore_pinyin_offset": false
        },
        // 1~18 的 edge ngram，覆盖完整订单号长度；token_chars 限 letter+digit。
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 18,
          "token_chars": [
            "letter",
            "digit"
          ]
        },
        // 单字 ngram（min=max=1），与 products 的 ngram_tokenizer 一致，
        // 但本索引多了 token_chars 限定。
        "ngram_tokenizer": {
          "type": "ngram",
          "min_gram": 1,
          "max_gram": 1,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      }
    }
  },

  "mappings": {
    // 同样是 strict：未来 OrderIndex struct 的 json tag 必须与下面 13 个 key 严格互等，
    // 且 copy_to_only_fields 为空 => 差集必须是空集（本索引没有任何虚拟字段）。
    "dynamic": "strict",

    // 13 个字段：order_id / order_id_suffix / uid / names / product_ids / order_status /
    // refund_status / shipping_type / pay_type / pay_type_name + pay_time / create_time / update_time。
    // 注意本索引【没有 _source.excludes】，四个大文本排除的排查限制只适用于 products。
    "properties": {
      // 订单号：索引期 edge_ngram（前缀即搜），查询期 standard。
      // 这种「索引/查询 analyzer 不对称」是 edge_ngram 前缀匹配的标准用法，不要「修正」成同一个。
      "order_id": {
        "type": "text",
        "analyzer": "edge_ngram_analyzer",
        "search_analyzer": "standard"
      },
      // 订单号尾串（配合按后几位搜索），与 order_id 同构。
      "order_id_suffix": {
        "type": "text",
        "analyzer": "edge_ngram_analyzer",
        "search_analyzer": "standard"
      },
      "uid": {
        "type": "keyword",
        "doc_values": false
      },
      // 商品名聚合字段（一单多商品拼接），单字 ngram + pinyin 子字段。
      "names": {
        "type": "text",
        "analyzer": "ngram_analyzer",
        "search_analyzer": "ngram_analyzer",
        "fields": {
          "pinyin": {
            "type": "text",
            "analyzer": "pinyin_analyzer"
          }
        }
      },
      // 订单内商品 id 集合：keyword + doc_values:false。
      // 【二期装配要点】这里是 keyword 单值语义，而一单多商品天然是数组，
      // 接线时必须确认写入侧产出的是数组还是拼接串（与 shop-search-api 现有查询逐条比对），
      // 若需要 nested 结构则属于 mapping 变更，必须走重建。
      "product_ids": {
        "type": "keyword",
        "doc_values": false
      },
      // 以下五个状态/类型字段一律 keyword + doc_values:false：查询侧只能 term，不能数值范围。
      "order_status": {
        "type": "keyword",
        "doc_values": false
      },
      "refund_status": {
        "type": "keyword",
        "doc_values": false
      },
      "shipping_type": {
        "type": "keyword",
        "doc_values": false
      },
      "pay_type": {
        "type": "keyword",
        "doc_values": false
      },
      "pay_type_name": {
        "type": "keyword",
        "doc_values": false
      },

      // ======================================================================
      // 【Phase 0 决定性发现 —— 二期接线前必须先解决，否则写入 100% 失败】
      // 本变体的三个 date 显式声明 format: "yyyy-MM-dd HH:mm:ss"。
      // 但 order-consumer 实际写入用的是 time.Time 的 stdlib 默认序列化（RFC3339）：
      //   order-consumer/consumer/order_index.go:11,16,17  —— 字段类型是 time.Time
      //   order-consumer/consumer/order_consumer.go:55     —— 直接 marshal 结构体，无自定义格式化
      // 两种形态【互不兼容】：真按本 mapping 建索引，order-consumer 的每一条写入都会
      // date_parse_exception（strict 下逐条失败，不是告警）。
      // 同目录另有 order-consumer/sql/shop-order.json —— 它的 date 【没有 format】，
      // 与 Go 写入器自洽（等价于 products 的默认 strict_date_optional_time||epoch_millis）。
      // 因此二期必须先二选一：
      //   A. 采用 shop-order.json（无 format）=> 保持 Go 写入 RFC3339，本文件按 A 重写；
      //   B. 保留本 format => 必须同步改 order-consumer 的序列化（跨仓库变更，还需重灌历史数据）。
      // 选定前本索引不得进入可执行清单。这也是 _meta.date_format 元数据位存在的原因：
      // products（无 format）与 orders（有 format）的时间序列化绝对不能共用一个函数。
      // ======================================================================
      "pay_time": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss"
      },
      "create_time": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss"
      },
      "update_time": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss"
      }
    }
  }
}
