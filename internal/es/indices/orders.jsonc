{
  // ==========================================================================
  // shop-order 索引结构声明 —— 【阶段二已接线】（_meta.status = active）
  // ==========================================================================
  //
  // 结构本体来源：order-consumer/sql/shop-order.json（13 字段、date 无 format 变体，
  // 全文原样，层级/数值/字段顺序未改），本文件只追加注释与 _meta。
  //
  // 接线现状（二期已打通全量灌数编排）：
  //   - 文档结构在 internal/es/doc_order.go（OrderIndex，13 个 json tag 与本 properties 严格互等，
  //     与 order-consumer/consumer/order_index.go 的 13 字段双向互等）；
  //   - 数据源 Provider / 差量补偿 / DB 计数口径在 internal/es/sync/order.go，已登记进
  //     registry_provider.go 的三张「别名 → 函数」表（键 shop-order）；
  //   - status=active 后本定义进入 ExecutableDefinitions()，es:migrate / es:status 按别名逐条处理。
  //   - 全量灌数编排已对订单可用（任务 #42）：sync/order.go 的 orderProvider 实现了 ingestTarget，
  //     SyncByAlias("shop-order") 走通 syncIndexTarget 的 checkpoint / 对账 / 灌入调优 / dry-run，
  //     es:migrate 首建、es:rebuild 蓝绿、es:cutover 割接三条编排都吃本索引；割接与迁移在发出任何
  //     ES 写请求之前先用 IngestOrchestrationReady 预检该别名编排可用，不可用即零写拒绝。
  //
  // 与 shop-product（indices/product.jsonc）的关键差异 —— 两套索引不能复用同一份配置假设：
  //   | 项              | shop-product        | shop-order            |
  //   |-----------------|---------------------|-----------------------|
  //   | number_of_shards| 15                  | 1                     |
  //   | number_of_replicas | 1              | 0（无副本）           |
  //   | index.sort      | price asc/sales desc/ficti desc | update_time desc |
  //   | analyzer 体系   | ik_max_word/ik_smart + pinyin + 单字 ngram | edge_ngram(1-18) + ngram + pinyin |
  //   | date format     | 无显式 format（默认 RFC3339） | 无显式 format（默认 RFC3339，见下） |
  //   | _source excludes| 排除 4 个大文本     | 无 excludes           |
  //   | 字段数          | 18（含虚拟 desc）   | 13（无 copy_to）      |
  //
  // 依赖插件：analysis-pinyin（pinyin tokenizer）。本索引【不依赖 analysis-ik】；
  // edge_ngram / ngram 为 ES 内置。插件健康检查必须逐索引做，不能共用。

  "_meta": {
    "alias": "shop-order",
    "schema_version": 1,
    "status": "active",
    "next_version_rule": "<alias>_v<N+1>",
    "copy_to_only_fields": [],
    "requires_plugins": ["analysis-pinyin"],
    "notes": "阶段二已接线。日期序列化二选一已定为 A：三个 date 字段【无显式 format】，走 ES 默认 strict_date_optional_time||epoch_millis，与本仓库 doc_order.go 用 time.Time 默认序列化（RFC3339）自洽，也与 order-consumer 写入一致。严禁改回 yyyy-MM-dd HH:mm:ss 或给订单单独做时间格式化——那会让本仓库与 order-consumer 的写入双双 date_parse_exception。_id=order_id（字符串订单号，非数字主键 id），routing=strconv.FormatInt(uid,10)；本索引 1 shard/0 replica、无 analysis-ik 依赖、无 is_show 维度。"
  },

  "settings": {
    // 动态项，可原地修改（灌数期间临时置 -1，完成后必须恢复到 1s 以匹配本文件）。
    "refresh_interval": "1s",

    // 与 products 的 15 分片相差悬殊：本索引单分片，重建代价低，
    // 但 number_of_shards 依旧是【静态项】，要调整仍然只能蓝绿重建。
    "number_of_shards": 1,

    // 无副本：查询可用性依赖主分片，扩容/容灾诉求变化时这里要重新评估（动态项，可原地置 1）。
    "number_of_replicas": 0,

    "index": {
      "store.preload": [
        "nvd",
        "dvd"
      ],

      // 排序预置字段：只有 update_time desc（商品索引是 price/sales/ficti 三键）。
      // 同样【创建后不可改】，需要按 pay_time 或金额排序时必须建模期定完，否则重建。
      "sort.field": [
        "update_time"
      ],
      "sort.order": [
        "desc"
      ],

      // slowlog 三项与 products 完全相同，均为动态项。
      "search.slowlog.threshold.query.warn": "500ms",
      "search.slowlog.threshold.fetch.warn": "1s",
      "indexing.slowlog.threshold.index.warn": "1s"
    },

    // analyzer 体系与 products 完全不同：这里走 edge_ngram 前缀匹配（订单号输入即搜），
    // products 走 ik 中文分词（商品名语义检索）。两套 analyzer 配置互不可移植，
    // 任何变更都必须重建（已分词数据不会重刷）。
    "analysis": {
      "analyzer": {
        // 订单号前缀搜索的索引期 analyzer（未显式声明 filter，行为与 products 的 ik 系完全不同）。
        "edge_ngram_analyzer": {
          "tokenizer": "edge_ngram_tokenizer"
        },
        "ngram_analyzer": {
          "tokenizer": "ngram_tokenizer"
        },
        // 与 products 的 pinyin_analyzer 同名，但底层 tokenizer 多一个
        // ignore_pinyin_offset: false（见下），两者并非等价配置。
        "pinyin_analyzer": {
          "tokenizer": "pinyin_tokenizer"
        }
      },
      "tokenizer": {
        "pinyin_tokenizer": {
          "type": "pinyin",
          "keep_separate_first_letter": true,
          "keep_full_pinyin": true,
          "keep_original": true,
          "limit_first_letter_length": 16,
          "lowercase": true,
          "remove_duplicated_term": true,
          // 与 products 的唯一差异项：false 会保留 token offset，高亮位置更准但开销略高。
          // 这行是「同名 analyzer 不等于同行为」的直接证据，跨索引复制配置前必须逐参数比对。
          "ignore_pinyin_offset": false
        },
        // 1~18 的 edge ngram，覆盖完整订单号长度；token_chars 限 letter+digit。
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 18,
          "token_chars": [
            "letter",
            "digit"
          ]
        },
        // 单字 ngram（min=max=1），与 products 的 ngram_tokenizer 一致，
        // 但本索引多了 token_chars 限定。
        "ngram_tokenizer": {
          "type": "ngram",
          "min_gram": 1,
          "max_gram": 1,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      }
    }
  },

  "mappings": {
    // 同样是 strict：未来 OrderIndex struct 的 json tag 必须与下面 13 个 key 严格互等，
    // 且 copy_to_only_fields 为空 => 差集必须是空集（本索引没有任何虚拟字段）。
    "dynamic": "strict",

    // 13 个字段：order_id / order_id_suffix / uid / names / product_ids / order_status /
    // refund_status / shipping_type / pay_type / pay_type_name + pay_time / create_time / update_time。
    // 注意本索引【没有 _source.excludes】，四个大文本排除的排查限制只适用于 products。
    "properties": {
      // 订单号：索引期 edge_ngram（前缀即搜），查询期 standard。
      // 这种「索引/查询 analyzer 不对称」是 edge_ngram 前缀匹配的标准用法，不要「修正」成同一个。
      "order_id": {
        "type": "text",
        "analyzer": "edge_ngram_analyzer",
        "search_analyzer": "standard"
      },
      // 订单号尾串（配合按后几位搜索），与 order_id 同构。
      "order_id_suffix": {
        "type": "text",
        "analyzer": "edge_ngram_analyzer",
        "search_analyzer": "standard"
      },
      "uid": {
        "type": "keyword",
        "doc_values": false
      },
      // 商品名聚合字段（一单多商品拼接），单字 ngram + pinyin 子字段。
      "names": {
        "type": "text",
        "analyzer": "ngram_analyzer",
        "search_analyzer": "ngram_analyzer",
        "fields": {
          "pinyin": {
            "type": "text",
            "analyzer": "pinyin_analyzer"
          }
        }
      },
      // 订单内商品 id 集合：keyword + doc_values:false。keyword 天然支持数组语义，
      // 装配侧（doc_order.BuildOrderDoc）产出【int64 数组】（与 order-consumer 一致），非拼接串。
      "product_ids": {
        "type": "keyword",
        "doc_values": false
      },
      // 以下五个状态/类型字段一律 keyword + doc_values:false：查询侧只能 term，不能数值范围。
      "order_status": {
        "type": "keyword",
        "doc_values": false
      },
      "refund_status": {
        "type": "keyword",
        "doc_values": false
      },
      "shipping_type": {
        "type": "keyword",
        "doc_values": false
      },
      "pay_type": {
        "type": "keyword",
        "doc_values": false
      },
      "pay_type_name": {
        "type": "keyword",
        "doc_values": false
      },

      // ======================================================================
      // 【日期序列化：阶段二已二选一定为 A —— 无 format，走 RFC3339】
      // 三个 date 字段【不声明 format】，走 ES 默认 strict_date_optional_time||epoch_millis，
      // 与本仓库写入器自洽：
      //   internal/es/doc_order.go        —— pay_time/create_time/update_time 是 time.Time，
      //                                      由 stdlib 默认序列化（RFC3339Nano），无 MarshalJSON；
      //   order-consumer/consumer/order_index.go —— 三个 date 字段同样是 time.Time，bulk 请求
      //                                      直接 Doc(orderIndex) 序列化，无格式化。
      // 若改回 "yyyy-MM-dd HH:mm:ss"，本仓库与 order-consumer 的每一条写入都会 date_parse_exception
      // （strict 下逐条失败，不是告警），且需重灌历史数据。故此处与上游 shop-order.json（无 format
      // 变体）逐字对齐，definition_test.go 的 TestDefinitionMatchesUpstreamSource 用该文件比指纹。
      // ======================================================================
      "pay_time": {
        "type": "date"
      },
      "create_time": {
        "type": "date"
      },
      "update_time": {
        "type": "date"
      }
    }
  }
}
